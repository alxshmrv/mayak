{
  "name": "mayak",
  "private": true,
  "version": "0.3.0",
  "description": "Локальный центр доверия к Wi-Fi для macOS и Windows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxshmrv/mayak.git"
  },
  "homepage": "https://github.com/alxshmrv/mayak#readme",
  "bugs": {
    "url": "https://github.com/alxshmrv/mayak/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:release": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "data:ieee": "node scripts/update-ieee-registries.mjs",
    "tauri": "tauri",
    "check": "npm run lint && npm run test && npm run test:release && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^6.0.1",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
